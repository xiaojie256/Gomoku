# Nginx 配置示例 - 用于 yanru529.cn/gomoku
# 将此配置添加到 nginx 的 server 块中
# 注意：Next.js 已配置 basePath: '/gomoku'，nginx 不需要剥离前缀

# 静态资源（长缓存，^~ 阻断正则匹配）
location ^~ /gomoku/_next/static/ {
    proxy_pass http://localhost:3000/gomoku/_next/static/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_buffering off;
    expires 1y;
    add_header Cache-Control "public, immutable";
}

# API 请求代理到后端（剥离 /gomoku 前缀，^~ 阻断正则匹配）
location ^~ /gomoku/api/ {
    proxy_pass http://localhost:4125/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
}

# WebSocket 支持（Socket.IO，剥离 /gomoku 前缀，^~ 阻断正则匹配）
location ^~ /gomoku/socket.io/ {
    proxy_pass http://localhost:4125/socket.io/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# 前端页面（正则匹配，去掉尾斜杠后转发，避免触发 Next.js basePath 308 重定向循环）
location ~ ^/gomoku(/.*)?$ {
    set $clean_uri $uri;
    if ($uri ~ ^(/gomoku.+)/$) {
        set $clean_uri $1;
    }
    if ($uri = /gomoku/) {
        set $clean_uri /gomoku;
    }
    proxy_pass http://localhost:3000$clean_uri$is_args$args;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
}
