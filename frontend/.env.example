# ==============================================================
# 五子棋前端环境变量示例
# 复制为 .env.local（本地）或 .env.production，.env* 已被 .gitignore 忽略
# ==============================================================

# ---- 后端 URL（Next.js rewrites 代理目标，仅服务端可见）----
# 本地开发：http://localhost:4125
# Docker 容器内：http://backend:4125（由 docker-compose 注入，无需手动设置）
BACKEND_URL=http://localhost:4125
