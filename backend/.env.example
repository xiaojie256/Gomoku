# ==============================================================
# 五子棋后端环境变量示例
# 复制为 .env 并填写实际值，.env 已被 .gitignore 忽略
# ==============================================================

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=gomoku_user
DB_PASSWORD=your_strong_password_here
DB_NAME=gomoku_db

# ---- Prisma 连接 URL（Prisma 必需，将上方变量填入即可）----
# 格式：postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://gomoku_user:your_strong_password_here@localhost:5432/gomoku_db

# ---- 管理员账号创建（node create_admin.js 使用）----
ADMIN_USER=admin
ADMIN_PASS=change_me_admin_password

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
# 生产环境请使用长度 ≥ 32 位的随机字符串
# 生成示例：openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret

# ---- 服务端口 ----
PORT=4125

# ---- CORS 允许的前端来源（逗号分隔，不含末尾斜杠）----
# 生产示例：https://gomoku.example.com
# 本地示例：http://localhost:3000,http://localhost:4125
CORS_ORIGINS=http://localhost:3000,http://localhost:4125

# ---- Node 环境 ----
NODE_ENV=development
